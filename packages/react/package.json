{
  "name": "@harshil1712/agent-ui",
  "version": "0.2.0",
  "description": "Agent application components for Cloudflare Agents SDK, built with Kumo",
  "author": "Harshil Agrawal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harshil1712/agent-ui.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/harshil1712/agent-ui#readme",
  "bugs": {
    "url": "https://github.com/harshil1712/agent-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./agents": {
      "types": "./dist/agents/index.d.ts",
      "import": "./dist/agents.js"
    },
    "./styles": "./dist/styles.css"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:memory": "node scripts/check-memory-leaks.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/markdown": "0.0.13"
  },
  "peerDependencies": {
    "@cloudflare/kumo": "^2.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "ai": "^7.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/kumo": "^2.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@storybook/addon-a11y": "latest",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/react-vite": "latest",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@testing-library/user-event": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "ai": "^7.0.59",
    "happy-dom": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "latest",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "latest",
    "vite-plugin-dts": "latest",
    "vitest": "latest"
  }
}
